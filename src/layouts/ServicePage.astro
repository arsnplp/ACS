---
/**
 * Gabarit de page service. Le contenu rédactionnel vient des slots :
 *  - slot "chapo"   : (non affiché depuis la mise en place des bannières)
 *  - slot par défaut : sections « Ce que comprend », « Déroulement », « Pourquoi ACS » (H2)
 *  - slot "villes"  : paragraphe d'intro de la zone d'intervention pour ce service
 * Le gabarit ajoute : H1, CTA, réalisations liées, villes, FAQ, services complémentaires, CTA final.
 */
import { getCollection } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import ImageSlot from '@/components/ImageSlot.astro';
import CtaDevis from '@/components/CtaDevis.astro';
import Faq from '@/components/Faq.astro';
import RealisationCard from '@/components/RealisationCard.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import { getService, serviceUrl, type ServiceSlug } from '@/data/services';
import { villesPrioritaires, villeUrl } from '@/data/villes';
import { serviceNode, type FaqItem } from '@/lib/seo';

interface Props {
  slug: ServiceSlug;
  title: string;
  description: string;
  h1: string;
  faq: FaqItem[];
  /** slugs des articles de blog liés */
  articles?: { slug: string; titre: string }[];
}
const { slug, title, description, h1, faq, articles = [] } = Astro.props;
const service = getService(slug)!;
const complementaires = service.complementaires.map((s) => getService(s)!);
const realisations = (await getCollection('realisations', (r) => r.data.service === slug)).slice(0, 3);
// Titre de bannière : « Métier à Romainville » en blanc, le détail après les deux-points en jaune (comme l'accueil)
const coupe = h1.indexOf(' : ');
const h1Debut = coupe > -1 ? h1.slice(0, coupe) : h1;
const h1Detail = coupe > -1 ? h1.slice(coupe + 3).replace(/^./, (c) => c.toUpperCase()) : '';
---
<BaseLayout
  title={title}
  description={description}
  ariane={[{ nom: 'Services', url: '/services/' }, { nom: service.nomLong, url: serviceUrl(slug) }]}
  ogImage="/images/hero-artisan.jpg"
  preload="/images/hero-artisan.jpg"
  faq={faq}
  jsonLd={[serviceNode({ nom: service.nomLong, serviceType: service.serviceType, url: serviceUrl(slug), description })]}
>
  <section class="banniere-service" aria-labelledby="titre-service">
    <div class="banniere-service__media">
      <ImageSlot nom="hero-artisan" alt="Seydou Traoré, artisan multiservices à Romainville, souriant en polo noir et salopette de travail" width={1672} height={700} lcp variante="hero" sizes="100vw" />
    </div>
    <div class="conteneur banniere-service__contenu">
      <h1 id="titre-service" class="banniere-service__titre">{h1Debut}{h1Detail && <span class="banniere-service__detail">{h1Detail}</span>}</h1>
      <p class="banniere-service__sous">{service.description}</p>
    </div>
  </section>

  <div class="conteneur section contenu-service">
    <slot />
  </div>

  <section class="section section--clair" aria-labelledby="realisations-titre">
    <div class="conteneur">
      <h2 id="realisations-titre">Réalisations en {service.nom.toLowerCase()}</h2>
      {realisations.length ? (
        <div class="grille">{realisations.map((r) => <RealisationCard realisation={r} />)}</div>
      ) : (
        <p>Les photos de chantier arrivent bientôt.</p>
      )}
      <p style="margin-top:1.5rem"><a href={`/realisations/?service=${slug}`}>Toutes nos réalisations en {service.nom.toLowerCase()}</a></p>
    </div>
  </section>

  <section class="section" aria-labelledby="complementaires-titre">
    <div class="conteneur">
      <h2 id="complementaires-titre">Services complémentaires</h2>
      <div class="grille">{complementaires.map((s) => <ServiceCard service={s} />)}</div>
      {articles.length > 0 && (
        <>
          <h3>Pour aller plus loin</h3>
          <ul>{articles.map((a) => <li><a href={`/blog/${a.slug}/`}>{a.titre}</a></li>)}</ul>
        </>
      )}
    </div>
  </section>

  <section class="section" aria-labelledby="zone-titre">
    <div class="conteneur contenu-service">
      <h2 id="zone-titre">Où intervenons-nous pour ce service ?</h2>
      <slot name="villes" />
      <ul class="chips">
        {villesPrioritaires.map((v) => <li><a href={villeUrl(v.slug)}>{service.ancreVille} {v.prep}</a></li>)}
        <li><a href="/zone-intervention/">Toute la zone d’intervention</a></li>
      </ul>
    </div>
  </section>

  <div class="conteneur">
    <Faq items={faq} />
  </div>

  <section class="section section--bleu fond-bleu" aria-labelledby="cta-final">
    <div class="conteneur">
      <h2 id="cta-final">Parlez-nous de votre projet</h2>
      <p class="chapo">Décrivez votre besoin par écrit, joignez des photos si vous le souhaitez. Nous vous répondons par le canal de votre choix : email ou téléphone.</p>
      <CtaDevis service={slug} />
    </div>
  </section>
</BaseLayout>
<style is:global>
  /* Bannière : même direction artistique que l'accueil (photo + dégradé bleu + titre blanc/jaune) */
  .banniere-service { position: relative; isolation: isolate; overflow: hidden; background: var(--bleu-fonce); color: var(--blanc); border-bottom: 4px solid var(--jaune); min-height: clamp(19rem, 42vh, 27rem); display: flex; align-items: center; }
  .banniere-service__media { position: absolute; inset: 0; z-index: -2; }
  .banniere-service__media picture, .banniere-service__media img, .banniere-service__media .img-slot { width: 100%; height: 100%; object-fit: cover; object-position: 80% 12%; display: block; }
  .banniere-service::before { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, rgb(10 42 77 / 0.95) 0%, rgb(10 42 77 / 0.88) 38%, rgb(10 42 77 / 0.45) 62%, rgb(10 42 77 / 0.12) 100%); }
  .banniere-service__contenu { padding-block: clamp(2.5rem, 6vw, 4rem); }
  .banniere-service__titre { color: var(--blanc); font-size: clamp(2rem, 1.4rem + 2vw, 3rem); line-height: 1.1; margin: 0; max-width: 36rem; text-wrap: balance; }
  .banniere-service__detail { display: block; margin-top: 0.5rem; font-size: clamp(1.15rem, 0.9rem + 1vw, 1.6rem); font-weight: 600; color: var(--jaune); line-height: 1.3; }
  .banniere-service__sous { margin: 0.9rem 0 0; max-width: 34rem; font-size: clamp(1.05rem, 1rem + 0.35vw, 1.25rem); line-height: 1.5; color: #e6edf6; }
  @media (max-width: 47.99rem) {
    .banniere-service { min-height: auto; display: block; }
    .banniere-service::before { display: none; }
    .banniere-service__media { position: relative; z-index: 0; aspect-ratio: 4 / 5; overflow: hidden; }
    .banniere-service__media picture { position: absolute; inset: 0; display: block; }
    .banniere-service__media img, .banniere-service__media .img-slot { object-position: 50% 50%; }
    .banniere-service__media::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgb(10 42 77 / 0) 38%, rgb(10 42 77 / 0.55) 62%, rgb(10 42 77 / 0.92) 82%, var(--bleu-fonce) 100%); }
    .banniere-service__contenu { position: relative; z-index: 1; margin-top: -50%; padding-block: 0 1.5rem; }
    .banniere-service__titre { font-size: clamp(2.1rem, 10vw, 2.8rem); line-height: 0.98; text-shadow: 0 2px 14px rgb(10 42 77 / 0.6); }
    .banniere-service__detail { margin-top: 0.45rem; font-size: 1.2rem; text-shadow: 0 1px 8px rgb(10 42 77 / 0.6); }
    .banniere-service__sous { display: none; }
  }
  /* Contenu des pages service : toute la largeur, listes sur deux colonnes */
  .contenu-service > * { max-width: none; }
  /* Chaque H2 ouvre une sous-section : filet de séparation + accent jaune */
  .contenu-service h2 { margin-top: 0; padding-top: clamp(2rem, 4vw, 3rem); border-top: 1px solid var(--bordure); position: relative; padding-bottom: 0.75rem; margin-bottom: 1.25rem; }
  .contenu-service h2::after { content: ''; position: absolute; left: 0; bottom: 0; width: 4.5rem; height: 5px; background: var(--jaune); border-radius: 999px; }
  .contenu-service > h2:first-child { padding-top: 0; border-top: 0; }
  .contenu-service > h2:not(:first-child) { margin-top: clamp(2rem, 4vw, 3rem); }
  .contenu-service .liste-coches { display: grid; grid-template-columns: 1fr; gap: 0.9rem 2.5rem; margin: 1.25rem 0 1.5rem; }
  .contenu-service .liste-coches li { margin: 0; background: var(--blanc); border: 1px solid var(--bordure); border-radius: var(--rayon); padding: 1rem 1.25rem 1rem 3rem; }
  .contenu-service .liste-coches li::before { left: 1rem; top: 1.25rem; }
  .contenu-service ul:not(.liste-coches):not(.chips) { display: grid; grid-template-columns: 1fr; gap: 0.6rem 2.5rem; padding-left: 1.25rem; }
  .contenu-service ul:not(.liste-coches):not(.chips) li { margin: 0; }
  @media (min-width: 48rem) {
    .contenu-service .liste-coches { grid-template-columns: repeat(2, 1fr); }
    .contenu-service ul:not(.liste-coches):not(.chips) { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 64rem) {
    .contenu-service .liste-coches { grid-template-columns: repeat(3, 1fr); }
    /* 4 éléments : 2 × 2 plutôt que 3 + 1 */
    .contenu-service .liste-coches:has(li:nth-child(4):last-child) { grid-template-columns: repeat(2, 1fr); }
  }
</style>
