---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import RealisationCard from '@/components/RealisationCard.astro';
import CtaDevis from '@/components/CtaDevis.astro';
import ImageSlot from '@/components/ImageSlot.astro';
import { services } from '@/data/services';
const toutes = (await getCollection('realisations')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---
<BaseLayout
  title="Réalisations artisan à Romainville (93) | ACS Multiservices"
  description="Avant / après de nos chantiers : meubles sur mesure, réparation, montage, rénovation, électricité, plomberie à Romainville et dans le 93. Filtre service."
  ariane={[{ nom: 'Réalisations', url: '/realisations/' }]}
  preload="/images/hero-realisations.jpg"
  ogImage="/images/hero-realisations.jpg"
>
  <section class="banniere-realisations" aria-labelledby="titre-realisations">
    <div class="banniere-realisations__media">
      <ImageSlot nom="hero-realisations" alt="Avant / après d'une rénovation : pièce en chantier avec escabeau et murs enduits, puis salon lumineux terminé avec canapé et parquet" width={1983} height={793} lcp variante="hero" sizes="100vw" />
    </div>
    <div class="conteneur banniere-realisations__contenu">
      <h1 id="titre-realisations" class="banniere-realisations__titre">Réalisations d’artisan <span class="banniere-realisations__lieu">à Romainville et en <span class="nowrap">Seine-Saint-Denis</span></span></h1>
      <p class="banniere-realisations__sous">Des projets concrets, des clients satisfaits : avant / après de nos chantiers.</p>
    </div>
  </section>
  </div>
  <section class="section" aria-labelledby="galerie-titre">
    <div class="conteneur">
      <h2 id="galerie-titre" class="visually-hidden">Galerie filtrable</h2>
      <p class="filtres__label" data-filtres-label hidden>Filtrer par service</p>
      <div class="filtres" role="group" aria-label="Filtrer par service" data-filtres hidden>
        <button type="button" aria-pressed="true" data-filtre="tous">Tous</button>
        {services.map((s) => <button type="button" aria-pressed="false" data-filtre={s.slug}>{s.nom}</button>)}
      </div>
      <p class="visually-hidden" aria-live="polite" data-filtre-statut></p>
      <div class="grille grille--realisations" data-galerie>
        {toutes.map((r) => <RealisationCard realisation={r} />)}
      </div>
      <p class="galerie-vide" data-galerie-vide hidden>Aucune réalisation publiée pour ce service pour le moment. <a href="/devis/">Décrivez votre projet</a>, il pourrait être le prochain.</p>
    </div>
  </section>

  <section class="section section--bleu fond-bleu">
    <div class="conteneur">
      <h2>Un projet du même type ?</h2>
      <p class="chapo">Envoyez-nous des photos de votre pièce et quelques mesures. Nous vous répondons par écrit ou par téléphone, selon votre choix.</p>
      <CtaDevis />
    </div>
  </section>
</BaseLayout>
<script>
  const filtres = document.querySelector<HTMLElement>('[data-filtres]');
  const statut = document.querySelector<HTMLElement>('[data-filtre-statut]');
  const cartes = document.querySelectorAll<HTMLElement>('[data-galerie] article[data-service]');
  const vide = document.querySelector<HTMLElement>('[data-galerie-vide]');
  if (filtres) {
    filtres.hidden = false;
    const label = document.querySelector<HTMLElement>('[data-filtres-label]'); if (label) label.hidden = false;
    const boutons = filtres.querySelectorAll<HTMLButtonElement>('button');
    const appliquer = (slug: string) => {
      boutons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filtre === slug)));
      let n = 0;
      cartes.forEach((c) => { const visible = slug === 'tous' || c.dataset.service === slug; c.hidden = !visible; if (visible) n++; });
      if (vide) vide.hidden = n > 0;
      if (statut) statut.textContent = slug === 'tous' ? `Tous les chantiers affichés (${n}).` : `${n} chantier(s) affiché(s) pour ce service.`;
    };
    boutons.forEach((b) => b.addEventListener('click', () => { appliquer(b.dataset.filtre!); history.replaceState(null, '', b.dataset.filtre === 'tous' ? location.pathname : `?service=${b.dataset.filtre}`); }));
    const initial = new URLSearchParams(location.search).get('service');
    if (initial && [...boutons].some((b) => b.dataset.filtre === initial)) appliquer(initial);
  }
</script>
<style>
  /* Bannière : même direction artistique que l'accueil (photo + dégradé bleu + titre blanc/jaune) */
  .banniere-realisations { position: relative; isolation: isolate; overflow: hidden; background: var(--bleu-fonce); color: var(--blanc); border-bottom: 4px solid var(--jaune); min-height: clamp(19rem, 42vh, 27rem); display: flex; align-items: center; }
  .banniere-realisations__media { position: absolute; inset: 0; z-index: -2; }
  .banniere-realisations__media :global(picture), .banniere-realisations__media :global(img), .banniere-realisations__media :global(.img-slot) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 50%; display: block; }
  .banniere-realisations::before { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, rgb(10 42 77 / 0.78) 0%, rgb(10 42 77 / 0.7) 50%, rgb(10 42 77 / 0.82) 100%); }
  .banniere-realisations__contenu { padding-block: clamp(2.5rem, 6vw, 4rem); text-align: center; }
  .banniere-realisations__titre { color: var(--blanc); font-size: clamp(2rem, 1.4rem + 2vw, 3rem); line-height: 1.1; margin: 0; max-width: 36rem; margin-inline: auto; text-shadow: 0 2px 18px rgb(10 42 77 / 0.7); text-wrap: balance; }
  .banniere-realisations__sous { margin: 0.9rem 0 0; max-width: 34rem; margin-inline: auto; text-shadow: 0 1px 10px rgb(10 42 77 / 0.7); font-size: clamp(1.05rem, 1rem + 0.35vw, 1.25rem); line-height: 1.5; color: #e6edf6; }
  .nowrap { white-space: nowrap; }
  @media (max-width: 47.99rem) {
    /* Mobile : la photo se fond dans le bleu, le titre vient par-dessus (comme l'accueil) */
    .banniere-realisations { min-height: auto; display: block; }
    .banniere-realisations__contenu { text-align: left; }
    .banniere-realisations::before { display: none; }
    .banniere-realisations__media { position: relative; z-index: 0; aspect-ratio: 4 / 5; overflow: hidden; }
    .banniere-realisations__media :global(picture) { position: absolute; inset: 0; display: block; }
    .banniere-realisations__media :global(img), .banniere-realisations__media :global(.img-slot) { object-position: 50% 50%; }
    .banniere-realisations__media::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgb(10 42 77 / 0) 38%, rgb(10 42 77 / 0.55) 62%, rgb(10 42 77 / 0.92) 82%, var(--bleu-fonce) 100%); }
    .banniere-realisations__contenu { position: relative; z-index: 1; margin-top: -50%; padding-block: 0 1.5rem; }
    .banniere-realisations__titre { font-size: clamp(2.1rem, 10vw, 2.8rem); line-height: 0.98; text-shadow: 0 2px 14px rgb(10 42 77 / 0.6); }
    .banniere-realisations__lieu { display: block; color: var(--jaune); margin-top: 0.45rem; font-size: 1.25rem; font-weight: 600; line-height: 1.3; letter-spacing: 0; }
    .banniere-realisations__lieu .nowrap { white-space: normal; }
    .banniere-realisations__sous { font-size: 1rem; margin-top: 0.7rem; color: var(--blanc); text-shadow: 0 1px 8px rgb(10 42 77 / 0.6); }
  }
  .filtres__label { font-family: var(--police-titre); font-weight: 700; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--texte-doux); margin: 0 0 0.6rem; }
  .filtres { margin-bottom: 2rem; }
  @media (max-width: 47.99rem) {
    /* Mobile : une seule ligne de pastilles qui défile horizontalement */
    .filtres { flex-wrap: nowrap; overflow-x: auto; overflow-y: hidden; gap: 0.4rem; margin: 0 -1rem 1.5rem; padding: 0.15rem 1rem 0.5rem; -webkit-overflow-scrolling: touch; scrollbar-width: none; touch-action: pan-x pan-y; overscroll-behavior-x: contain; scroll-padding-inline: 1rem; }
    .filtres::after { content: ''; flex: none; width: 0.5rem; } /* respiration après le dernier bouton */
    .filtres::-webkit-scrollbar { display: none; }
    .filtres button { flex: none; min-height: 40px; padding: 0.4rem 0.9rem; font-size: 0.92rem; border-width: 1.5px; white-space: nowrap; }
  }
  .grille--realisations { grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr)); }
  @media (min-width: 64rem) { .grille--realisations { grid-template-columns: repeat(3, 1fr); } }
  .grille--realisations :global(.carte__corps h3) { font-size: 1.15rem; line-height: 1.3; }
  .grille--realisations :global(.carte__corps .meta) { order: -1; margin: 0; }
  .grille--realisations :global(article[hidden]) { display: none; }
  .grille--realisations :global(.carte > picture img), .grille--realisations :global(.carte > .img-slot) { aspect-ratio: 3 / 2; width: 100%; height: auto; object-fit: cover; }
  .groupe { margin-bottom: 2.5rem; }
  .groupe h2 a { text-decoration: none; }
  .groupe h2 a:hover { text-decoration: underline; }
</style>
