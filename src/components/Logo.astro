---
/** Logotype texte en attendant le logo définitif ({{LOGO}}). */
interface Props { surBleu?: boolean }
const { surBleu = false } = Astro.props;
---
<span class:list={['logo', { 'logo--bleu': surBleu }]}>
  <span class="logo__acs" aria-hidden="true">ACS</span>
  <span class="logo__texte"><span class="visually-hidden">ACS </span>Multiservices</span>
</span>
<style>
  .logo { display: inline-flex; align-items: center; gap: 0.45rem; font-family: var(--police-titre); font-weight: 800; font-size: 1.35rem; letter-spacing: -0.01em; color: var(--bleu); line-height: 1; }
  .logo__acs { background: var(--jaune); color: var(--bleu-fonce); padding: 0.3rem 0.5rem; border-radius: 4px; }
  .logo--bleu { color: var(--blanc); }
</style>
