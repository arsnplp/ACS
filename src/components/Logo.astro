---
/** Logo ACS Multiservices (image fournie par le client). Sur fond bleu, il est posé sur une plaque blanche. */
interface Props { surBleu?: boolean }
const { surBleu = false } = Astro.props;
---
<span class:list={['logo', { 'logo--plaque': surBleu }]}>
  <picture>
    <source srcset="/images/logo-acs-multiservices.webp" type="image/webp" />
    <img src="/images/logo-acs-multiservices.png" alt="ACS Multiservices" width="437" height="92" decoding="async" />
  </picture>
</span>
<style>
  .logo { display: inline-flex; align-items: center; line-height: 0; }
  .logo img { height: 2.75rem; width: auto; display: block; }
  .logo--plaque { background: var(--blanc); border-radius: 10px; padding: 0.55rem 0.8rem; }
  .logo--plaque img { height: 2.5rem; }
  @media (min-width: 48rem) { .logo img { height: 3.1rem; } }
</style>
