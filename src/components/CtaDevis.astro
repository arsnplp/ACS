---
import { libelleDevis } from '@/data/entreprise';
interface Props { service?: string; texte?: string; classe?: string }
const { service, texte = libelleDevis, classe = 'btn btn--jaune' } = Astro.props;
const href = service ? `/devis/?service=${service}` : '/devis/';
---
<a class={classe} href={href}>{texte}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
