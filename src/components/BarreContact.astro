---
/**
 * Barre de contact fixe en bas d'écran, sur mobile uniquement :
 * « Demander un devis » + « M’appeler » (ou « Email » tant que le téléphone n'est pas renseigné).
 * Masquée sur la page devis (le formulaire est déjà là) et à l'impression.
 */
import { entreprise, libelleDevis, estPlaceholder } from '@/data/entreprise';
const telHref = entreprise.telephoneHref && !estPlaceholder(entreprise.telephone) ? `tel:${entreprise.telephoneHref}` : '';
const surDevis = Astro.url.pathname.startsWith('/devis/');
---
{!surDevis && (
  <nav class="barre-contact" aria-label="Contact rapide">
    <a class="barre-contact__btn barre-contact__btn--devis" href="/devis/">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/><path d="M14 3v6h6M9 13h6M9 17h6"/></svg>
      <span>{libelleDevis}</span>
    </a>
    {telHref ? (
      <a class="barre-contact__btn" href={telHref}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 3h4l2 5-2.5 1.5a11 11 0 0 0 6 6L16 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 5a2 2 0 0 1 2-2"/></svg>
        <span>M’appeler</span>
      </a>
    ) : (
      <a class="barre-contact__btn" href={`mailto:${entreprise.email}`}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
        <span>Email</span>
      </a>
    )}
  </nav>
)}
<style>
  .barre-contact { display: none; }
  @media (max-width: 47.99rem) {
    .barre-contact {
      position: fixed; left: 0; right: 0; bottom: 0; z-index: 50;
      display: grid; grid-auto-flow: column; grid-auto-columns: 1fr; gap: 0.5rem;
      grid-template-columns: 1.5fr 1fr;
      padding: 0.5rem 0.75rem calc(0.5rem + env(safe-area-inset-bottom, 0px));
      background: rgb(255 255 255 / 0.96); backdrop-filter: blur(8px);
      border-top: 1px solid var(--bordure); box-shadow: 0 -4px 16px rgb(10 42 77 / 0.12);
    }
    .barre-contact__btn {
      display: inline-flex; align-items: center; justify-content: center; gap: 0.45rem;
      min-height: 46px; padding: 0.5rem 0.6rem; border-radius: 10px; white-space: nowrap;
      font-family: var(--police-titre); font-weight: 700; font-size: 0.92rem; text-decoration: none;
      background: var(--bleu); color: var(--blanc); border: 2px solid var(--bleu);
    }
    .barre-contact__btn--devis { background: var(--jaune); color: var(--bleu-fonce); border-color: var(--jaune); }
    .barre-contact__btn svg { width: 1.2rem; height: 1.2rem; flex: none; }
    .barre-contact__btn:focus-visible { outline: 3px solid var(--jaune-fonce); outline-offset: 2px; }
    /* Laisse la place à la barre pour que le pied de page reste lisible */
    :global(body:has(.barre-contact)) { padding-bottom: calc(4.25rem + env(safe-area-inset-bottom, 0px)); }
  }
  @media print { .barre-contact { display: none !important; } }
</style>
