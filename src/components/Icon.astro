---
/** Pictogramme décoratif (aria-hidden). */
interface Props { path: string; class?: string }
const { path, class: cls } = Astro.props;
---
<svg class={cls} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d={path}></path></svg>
