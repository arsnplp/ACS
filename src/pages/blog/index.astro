---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import CtaDevis from '@/components/CtaDevis.astro';
import ImageSlot from '@/components/ImageSlot.astro';
import { getService, serviceUrl } from '@/data/services';
const articles = (await getCollection('blog', (a) => !a.data.brouillon)).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---
<BaseLayout
  title="Conseils travaux et meubles dans le 93 | ACS Multiservices"
  description="Guides pratiques d’un artisan de Romainville : prix d’un meuble sur mesure, réparer ou remplacer un meuble, fuite sous l’évier. Préparez vos travaux."
  ariane={[{ nom: 'Conseils', url: '/blog/' }]}
  preload="/images/hero-artisan.jpg"
  ogImage="/images/hero-artisan.jpg"
>
  <section class="banniere-blog" aria-labelledby="titre-blog">
    <div class="banniere-blog__media">
      <ImageSlot nom="hero-artisan" alt="Seydou Traoré, artisan multiservices à Romainville, souriant en polo noir et salopette de travail" width={1672} height={700} lcp variante="hero" sizes="100vw" />
    </div>
    <div class="conteneur banniere-blog__contenu">
      <h1 id="titre-blog" class="banniere-blog__titre">Conseils et guides pratiques <span class="banniere-blog__detail">pour vos meubles et vos travaux</span></h1>
      <p class="banniere-blog__sous">Astuces d’artisan, prix, erreurs à éviter : de quoi préparer vos projets avant de nous écrire.</p>
    </div>
  </section>
  <section class="section" aria-labelledby="liste-titre">
    <div class="conteneur">
      <h2 id="liste-titre">Tous les articles</h2>
      <div class="grille grille--blog">
        {articles.map((a) => { const s = getService(a.data.service)!; return (
          <article class="carte">
            <div class="carte__corps">
              <p class="meta"><time datetime={a.data.date.toISOString().slice(0, 10)}>{a.data.date.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })}</time> · <a href={serviceUrl(s.slug)}>{s.nom}</a></p>
              <h3><a href={`/blog/${a.id}/`}>{a.data.titre}</a></h3>
              <p>{a.data.description}</p>
            </div>
          </article>
        ); })}
      </div>
    </div>
  </section>
  <section class="section section--bleu fond-bleu">
    <div class="conteneur">
      <h2>Une question sur votre situation ?</h2>
      <p class="chapo">Décrivez-la par écrit avec une photo. Nous répondons par email ou téléphone.</p>
      <CtaDevis />
    </div>
  </section>
</BaseLayout>
<style>
  /* Bannière : même direction artistique que l'accueil (photo + dégradé bleu + titre blanc/jaune) */
  .banniere-blog { position: relative; isolation: isolate; overflow: hidden; background: var(--bleu-fonce); color: var(--blanc); border-bottom: 4px solid var(--jaune); min-height: clamp(19rem, 42vh, 27rem); display: flex; align-items: center; }
  .banniere-blog__media { position: absolute; inset: 0; z-index: -2; }
  .banniere-blog__media :global(picture), .banniere-blog__media :global(img), .banniere-blog__media :global(.img-slot) { width: 100%; height: 100%; object-fit: cover; object-position: 80% 12%; display: block; }
  .banniere-blog::before { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, rgb(10 42 77 / 0.95) 0%, rgb(10 42 77 / 0.88) 38%, rgb(10 42 77 / 0.45) 62%, rgb(10 42 77 / 0.12) 100%); }
  .banniere-blog__contenu { padding-block: clamp(2.5rem, 6vw, 4rem); }
  .banniere-blog__titre { color: var(--blanc); font-size: clamp(2rem, 1.4rem + 2vw, 3rem); line-height: 1.1; margin: 0; max-width: 36rem; text-wrap: balance; }
  .banniere-blog__detail { display: block; margin-top: 0.5rem; font-size: clamp(1.15rem, 0.9rem + 1vw, 1.6rem); font-weight: 600; color: var(--jaune); line-height: 1.3; }
  .banniere-blog__sous { margin: 0.9rem 0 0; max-width: 34rem; font-size: clamp(1.05rem, 1rem + 0.35vw, 1.25rem); line-height: 1.5; color: #e6edf6; }
  @media (max-width: 47.99rem) {
    .banniere-blog { min-height: auto; display: block; }
    .banniere-blog::before { display: none; }
    .banniere-blog__media { position: relative; z-index: 0; aspect-ratio: 4 / 5; overflow: hidden; }
    .banniere-blog__media :global(picture) { position: absolute; inset: 0; display: block; }
    .banniere-blog__media :global(img), .banniere-blog__media :global(.img-slot) { object-position: 50% 50%; }
    .banniere-blog__media::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgb(10 42 77 / 0) 38%, rgb(10 42 77 / 0.55) 62%, rgb(10 42 77 / 0.92) 82%, var(--bleu-fonce) 100%); }
    .banniere-blog__contenu { position: relative; z-index: 1; margin-top: -50%; padding-block: 0 1.5rem; }
    .banniere-blog__titre { font-size: clamp(2.1rem, 10vw, 2.8rem); line-height: 0.98; text-shadow: 0 2px 14px rgb(10 42 77 / 0.6); }
    .banniere-blog__detail { margin-top: 0.45rem; font-size: 1.2rem; text-shadow: 0 1px 8px rgb(10 42 77 / 0.6); }
    .banniere-blog__sous { display: none; }
  }
  .grille--blog { grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr)); }
  @media (min-width: 64rem) { .grille--blog { grid-template-columns: repeat(3, 1fr); } }
  .carte--a-venir { border-style: dashed; opacity: 0.85; }
  .carte--a-venir h3 { color: var(--texte-doux); }
  .carte__corps h3 a { text-decoration: none; }
  .carte__corps h3 a:hover { text-decoration: underline; }
  .carte__corps .meta { flex: 0; margin: 0; }
</style>
