---
/**
 * Les deux moyens de contact, au même niveau visuel : email et téléphone.
 * Le téléphone n'est jamais le seul canal : l'email reste au même niveau.
 */
import { entreprise } from '@/data/entreprise';
interface Props { titre?: string }
const { titre } = Astro.props;
const telHref = entreprise.telephoneHref ? `tel:${entreprise.telephoneHref}` : '';
---
{titre && <p class="surtitre">{titre}</p>}
<ul class="contact-cartes">
  <li>
    <a class="contact-carte" href={`mailto:${entreprise.email}`}>
      <span class="contact-carte__picto" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
      </span>
      <span class="contact-carte__texte">
        <span class="contact-carte__titre">Par email</span>
        <span class="contact-carte__valeur">{entreprise.email}</span>
        <span class="contact-carte__detail">Réponse écrite, avec photos et devis en pièce jointe. Pratique pour garder une trace.</span>
      </span>
      <span class="contact-carte__fleche" aria-hidden="true">→</span>
    </a>
  </li>
  <li>
    {telHref ? (
      <a class="contact-carte" href={telHref}>
        <span class="contact-carte__picto" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 3h4l2 5-2.5 1.5a11 11 0 0 0 6 6L16 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 5a2 2 0 0 1 2-2"/></svg>
        </span>
        <span class="contact-carte__texte">
          <span class="contact-carte__titre">Par téléphone</span>
          <span class="contact-carte__valeur">{entreprise.telephone}</span>
          <span class="contact-carte__detail">Horaires : {entreprise.horaires}. Pas de réponse ? Laissez un message, nous rappelons.</span>
        </span>
        <span class="contact-carte__fleche" aria-hidden="true">→</span>
      </a>
    ) : (
      <span class="contact-carte contact-carte--inactif">
        <span class="contact-carte__picto" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 3h4l2 5-2.5 1.5a11 11 0 0 0 6 6L16 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 5a2 2 0 0 1 2-2"/></svg>
        </span>
        <span class="contact-carte__texte">
          <span class="contact-carte__titre">Par téléphone</span>
          <span class="contact-carte__valeur">{entreprise.telephone}</span>
          <span class="contact-carte__detail">Horaires : {entreprise.horaires}. Pas de réponse ? Laissez un message, nous rappelons.</span>
        </span>
      </span>
    )}
  </li>
</ul>
<style>
  .contact-cartes { list-style: none; padding: 0; margin: 0; display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr)); }
  .contact-cartes li { margin: 0; }
  .contact-carte {
    display: grid; grid-template-columns: auto 1fr auto; gap: 1.1rem; align-items: center;
    min-height: 3rem; padding: 1.35rem 1.5rem; height: 100%;
    background: var(--blanc); color: var(--texte); border: 2px solid var(--bleu); border-radius: 12px;
    box-shadow: var(--ombre); text-decoration: none; position: relative; overflow: hidden;
    transition: transform var(--transition), box-shadow var(--transition), border-color var(--transition);
  }
  .contact-carte::before { content: ''; position: absolute; inset: 0 auto 0 0; width: 6px; background: var(--jaune); }
  a.contact-carte:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgb(15 61 110 / 0.16); }
  a.contact-carte:hover .contact-carte__fleche { transform: translateX(4px); }
  .contact-carte__picto { width: 3.5rem; height: 3.5rem; border-radius: 50%; background: var(--bleu); color: var(--jaune); display: grid; place-items: center; flex: none; }
  .contact-carte__picto svg { width: 1.75rem; height: 1.75rem; }
  .contact-carte__texte { display: grid; gap: 0.15rem; min-width: 0; }
  .contact-carte__titre { font-family: var(--police-titre); font-weight: 800; font-size: 1.2rem; color: var(--bleu); }
  .contact-carte__valeur { font-family: var(--police-titre); font-weight: 700; font-size: 1.05rem; color: var(--texte); overflow-wrap: anywhere; }
  .contact-carte__detail { font-size: 0.95rem; color: var(--texte-doux); line-height: 1.45; }
  .contact-carte__fleche { font-size: 1.5rem; font-weight: 800; color: var(--bleu); transition: transform var(--transition); }
  .contact-carte--inactif { border-style: dashed; }
  /* Sur fond bleu : cartes claires qui ressortent, texte foncé conservé pour le contraste */
  .section--bleu .contact-carte { border-color: var(--jaune); box-shadow: 0 10px 30px rgb(0 0 0 / 0.25); }
  .section--bleu .contact-carte:focus-visible { outline-color: var(--jaune); }
  @media (max-width: 30rem) {
    .contact-carte { grid-template-columns: 1fr; gap: 0.75rem; padding: 1.25rem 1.25rem 1.25rem 1.5rem; }
    .contact-carte__fleche { display: none; }
    .contact-carte__picto { width: 3rem; height: 3rem; }
    .contact-carte__valeur { font-size: 1rem; }
  }
</style>
